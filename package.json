{
  "name": "lyrics-display",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "board-status": "bun scripts/board-status.ts",
    "triage-outcome": "bun scripts/triage-outcome.ts",
